{
  "name": "clesson-de/silverstripe-codeguard",
  "description": "A read-only quality and security gate for SilverStripe modules and applications.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "silverstripe",
    "security",
    "quality",
    "ci"
  ],
  "require": {
    "php": "^8.2",
    "composer/semver": "^3.4",
    "symfony/console": "^7.2 || ^8.0",
    "symfony/process": "^7.2 || ^8.0",
    "symfony/yaml": "^7.2 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Clesson\\SilverStripeCodeGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Clesson\\SilverStripeCodeGuard\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/silverstripe-codeguard"
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": "@test"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
